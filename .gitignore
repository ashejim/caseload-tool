.venv/
browser_data/
screenshots/
.env
__pycache__/
*.pyc
.pytest_cache/
.playwright/
.idea/
.vscode/
.claude/
build/
dist/
dist-nuitka/
*.spec.bak

# Real student data captured during inspection — FERPA, don't commit.
# Ignore the folder's CONTENTS (HTML/PNG snapshots) but keep the two shipped
# app assets. (Must be `resources/*` not `resources/` so the negations apply —
# git can't re-include a file inside a wholly-excluded directory.)
resources/*
!resources/app.ico
!resources/splash.png

# Nuitka intermediates
*.build/
*.dist/
*.onefile-build/

# Release archives — distribute via GitHub Releases, not the repo.
CaseloadNotes-*.zip

# Per-user session log (created at runtime in dev mode).
note_log.csv

# Local data-at-rest encryption (src/crypto_store.py). vault.json holds the
# password salt + verifier + DPAPI-sealed key; *.enc are the encrypted student
# data files; *.tmp is atomic-write scratch. Never commit any of these.
vault.json
*.enc
# Safety copies crypto_store keeps beside each encrypted file: the previous
# .enc on every save, dated backups when data shrinks, and set-aside stray
# plaintext (may be UNENCRYPTED student data).
*.enc.prev
*.enc.bak-*
*.stray-*
*.tmp

# Diagnostic reports from the 'griddiff:' / 'gridbuild:' keywords — hold student
# values (PII).
griddiff_report.txt
gridbuild_report.txt
gridschema_report.txt
coursescan_report.txt
coursescan_roster.json
# Inbox-labeler decision log + seen-state (scripts/label_inbox.py) —
# sender names/emails/subjects = student PII.
inbox_label_log.jsonl
inbox_label_state.json

# Cached caseload export — student PII, FERPA, never commit.
caseload.csv
# Backups/temp written by the download anti-clobber guard (also PII).
caseload.csv.*
# Local caseload history snapshots — student PII, FERPA, never commit
# (covers history.db and any -journal/-wal/-shm sidecars + CSV exports).
history.db*
caseload_history.csv
# Local per-student Success Path state (field values + step log) — PII, FERPA.
success_path.db*
# Local data-analysis notes — contain real student names/IDs + performance
# figures. PII/FERPA + personal; never commit to the public repo.
data_analysis/
# Mongoose contacts/segment exports (Contact ids + names + mobiles) — PII.
# These can be named anything (e.g. "all C769 students-cfad.csv"), so the
# narrow patterns below aren't enough on their own.
mongoose*.csv
*segment*.csv
*contacts*.csv
# CATCH-ALL: the config dir IS the repo root in dev, where every CSV export
# (caseload + Mongoose segments) lands. Treat ALL root-level CSVs as local PII
# and never commit them. Use `git add -f` for the rare CSV meant to be tracked.
/*.csv
# Single-instance lock file (runtime).
launcher.lock

# Local caseload CSV backups (scripts/export_caseload_backup.py) — full student
# PII in PLAINTEXT, FERPA. The root-level /*.csv rule above doesn't reach a
# subfolder, so exclude the whole backups dir explicitly. Never commit.
backups/

# Local working folder of source/branding art — includes THIRD-PARTY logos
# (Salesforce, Mongoose) and large source GIFs. Never commit: trademark/
# copyright + repo bloat. Shipped app assets live in resources/ (app.ico,
# splash.gif), which are whitelisted above.
branding images/

# The user's live scenarios (their personal batches/scenarios/emails).
# Only the bundled sample, default_scenarios.yaml, is tracked. The legacy
# notes.yaml name + its backups are ignored too.
scenarios.yaml
scenarios.yaml.bak
scenarios-*.yaml
notes.yaml
notes.yaml.bak*

# Browser-preview temp written by the HTML editor's Preview button.
_preview.html

# Per-user settings (advanced mode, first-run flag, etc.) — local
# to each install; don't commit.
settings.json

# User-specific email templates — the user's live folder(s). Only the
# bundled sample set (default_email_templates/) ships with the repo.
# Real students' emails contain identifiable correspondence; keep them
# out of source control (FERPA). "templates/" is the legacy folder name.
email_templates/
templates/

# Network-capture dumps from the 🔬 Capture button. Contain
# Salesforce session cookies + aura.token (active credentials)
# AND student PII inside the request bodies. Never commit.
capture-*.json

# Dev DOM dumps + scratch dir used while reverse-engineering the
# Salesforce notes DOM. Contain student PII; never commit.
dom_dump.html
temp/

# Inline-edit / task-unlock diagnostic dumps written at runtime to debug
# Salesforce commit failures. Contain captured DOM (may include PII); the app
# writes them under USER_CONFIG_DIR — a repo-root copy is a stale artifact.
flup_probe.txt
unlock_probe.txt
aura_probe.txt
ea_feed_probe.txt
flup_save_probe.txt
text_send_probe.txt
mongoose_api_probe.txt
oc_probe*.txt
roster_popup_probe.txt
# Harvested grid request (contains live aura.token — session credential).
roster_grid_request_probe.txt
# Learned credential-free grid-request template for the fast roster refresh
# (params carry mentor/user ids — local only).
roster_grid_template.json

# Fresh-install demo sandbox (isolated config for onboarding troubleshooting)
_fresh_demo/
# Offline contributor demo sandbox (scripts/demo.py) — generated sample data +
# local settings; the committed source is scripts/sample_data.py + sample_data/.
_demo/
# Generated sample data (regenerated by scripts/demo.py). The browsable,
# committed copies are sample_data/sample_caseload.csv + sample_outcomes.csv.
sample_data/history.db
sample_data/caseload.csv

# Per-user learned spell-check words (src/spellcheck.py)
spell_custom.txt

# Temp grid-probe dump (PII); the running dev instance can recreate it until restart.
grid_nested_probe.json

# Learner360 change-watch state (release fingerprint + feature flags; per
# machine, regenerated by l360momi:). Not student data, but not source either.
learner360_watch.json
